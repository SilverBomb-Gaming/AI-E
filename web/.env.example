# Copy to web/.env.local for local overrides. Never commit secrets.

# Demo mode is the default. Leave OPENAI_API_KEY empty and the public
# chat spine uses the local planner tool with no private keys.
OPENAI_API_KEY=
AIE_FORCE_DEMO=0
AIE_REASONING_MODEL=gpt-4o-mini

# Optional Unity analysis backend (existing /analyze path).
AIE_ANALYSIS_BACKEND_URL=
AIE_PYTHON_BIN=
BASE_URL=http://localhost:3000

AIE_REASONING_PROVIDER=openai
AIE_LIGHT_PROVIDER=local-openai
AIE_LIGHT_MODEL=qwen2.5:7b-instruct
AIE_REWRITE_MODEL=gpt-4.1-nano
AIE_LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
AIE_REASONING_CACHE_TTL_MS=300000
AIE_REWRITE_CACHE_TTL_MS=600000
